---
/**
 * Button.astro — Botón reutilizable con variantes
 * ============================================
 * Uso: <Button variant="primary" href="/contacto">Cotizar</Button>
 * Variantes: primary | dark | whatsapp | outline
 * Tamaños: sm | md | lg
 * ============================================
 */

interface Props {
  variant?: 'primary' | 'dark' | 'whatsapp' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href: string;
  external?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  external = false,
  class: className = ''
} = Astro.props;

// Si es externo (WhatsApp, redes), abre en nueva pestaña con seguridad
const linkAttrs = external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<a 
  href={href} 
  class={`btn btn--${variant} btn--${size} ${className}`}
  {...linkAttrs}
>
  <slot />
</a>

<style>
  /* ============================================
     BUTTON.CSS — Estilos del componente Button
     Mobile-First + tipografía fluida
     ============================================ */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
    text-align: center;
    border-radius: 10px;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.3s ease, box-shadow 0.3s ease;
    white-space: nowrap;
    line-height: 1;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn:active {
    transform: translateY(0);
  }

  /* --- Tamaños (fluidos con clamp) --- */
  .btn--sm {
    padding: 0.8rem 1.7rem;
    font-size: clamp(0.8rem, 0.75rem + 0.2vw, 0.9rem);
  }

  .btn--md {
    padding: 0.95rem 2.5rem;
    font-size: clamp(0.9rem, 0.85rem + 0.25vw, 1rem);
  }

  .btn--lg {
    padding: 1.15rem 3.8rem;
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.15rem);
  }

  /* --- Variante: Primary (naranja, CTA principal) --- */
  .btn--primary {
    background-color: var(--color-secondary);
    color: #fff;
    box-shadow: 0 4px 14px rgba(255, 107, 53, 0.3);
  }

  .btn--primary:hover {
    background-color: #FF8C5A;
    box-shadow: 0 6px 20px rgba(255, 107, 53, 0.4);
  }

  /* --- Variante: Dark (azul noche, secundario) --- */
  .btn--dark {
    background-color: var(--color-primary);
    color: #fff;
  }

  .btn--dark:hover {
    background-color: var(--color-primary-light);
  }

  /* --- Variante: WhatsApp (verde oficial) --- */
  .btn--whatsapp {
    background-color: #25D366;
    color: #fff;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.3);
  }

  .btn--whatsapp:hover {
    background-color: #20BD5A;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
  }

  /* --- Variante: Outline (borde, para fondos oscuros/imágenes) --- */
  .btn--outline {
    background-color: transparent;
    color: #fff;
    border: 2px solid #fff;
  }

  .btn--outline:hover {
    background-color: #fff;
    color: var(--color-primary);
  }

  /* --- Accesibilidad: foco visible con teclado --- */
  .btn:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: 3px;
  }
</style>