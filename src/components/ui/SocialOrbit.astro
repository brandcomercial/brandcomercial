---

<div class="social-orbit">
  <div class="social-orbit__ring">
    {socials.map((social, i) => (
      <a 
        href={social.url} 
        target="_blank" 
        rel="noopener noreferrer"
        class="social-orbit__item"
        style={`--angle: ${i * 90}deg`}
        aria-label={`Visitar ${social.name}`}
      >
        <span class="social-orbit__icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" set:html={icons[social.icon]}></svg>
        </span>
      </a>
    ))}
  </div>
  <div class="social-orbit__center">
    <!-- Isotipo de brandcomercial -->
