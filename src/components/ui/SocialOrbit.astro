<style>
  /* ============================================
     SOCIAL-ORBIT.CSS — Órbita infinita
     ============================================ */

  .social-orbit {
    position: relative;
    width: 260px;
    height: 260px;
  }

  @media (max-width: 767px) {
    .social-orbit {
      width: 200px;
      height: 200px;
    }
  }

  /* Círculo central translúcido */
  .social-orbit__center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 270px;
    height: 270px;
    border-radius: 50%;
    background-color: rgba(10, 25, 47, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    z-index: 2;
  }

  @media (max-width: 767px) {
    .social-orbit__center {
      width: 190px;
      height: 190px;
    }
  }

  /* Anillo que rota */
  .social-orbit__ring {
    position: absolute;
    inset: 0;
    animation: spin 20s linear infinite;
    z-index: 3;
  }

  /* Pausa al hover en cualquier parte */
  .social-orbit:hover .social-orbit__ring,
  .social-orbit:hover .social-orbit__icon {
    animation-play-state: paused;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Items posicionados en el borde del círculo */
  .social-orbit__item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
    transform: rotate(var(--angle)) translate(130px) rotate(calc(var(--angle) * -1));
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: #fff;
    box-shadow: 0 4px 12px rgba(10, 25, 47, 0.15);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    z-index: 3;
  }

  @media (max-width: 767px) {
    .social-orbit__item {
      width: 40px;
      height: 40px;
      margin: -20px 0 0 -20px;
      transform: rotate(var(--angle)) translate(100px) rotate(calc(var(--angle) * -1));
    }
  }

  .social-orbit__item:hover {
    transform: rotate(var(--angle)) translate(130px) rotate(calc(var(--angle) * -1)) scale(1.15);
    box-shadow: 0 6px 20px rgba(10, 25, 47, 0.25);
  }

  @media (max-width: 767px) {
    .social-orbit__item:hover {
      transform: rotate(var(--angle)) translate(100px) rotate(calc(var(--angle) * -1)) scale(1.15);
    }
  }

  /* Icono contra-rota para mantenerse derecho */
  .social-orbit__icon {
    width: 24px;
    height: 24px;
    color: var(--color-primary);
    animation: spin-reverse 20s linear infinite;
  }

  @media (max-width: 767px) {
    .social-orbit__icon {
      width: 20px;
      height: 20px;
    }
  }

  @keyframes spin-reverse {
    to { transform: rotate(-360deg); }
  }

  .social-orbit__icon svg {
    width: 100%;
    height: 100%;
  }
</style>