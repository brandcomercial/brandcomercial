---
/**
 * Button.astro — Botón reutilizable con variantes
 * ============================================
 * Uso: <Button variant="primary" href="/contacto">Cotizar</Button>
 * Variantes: primary | dark | whatsapp | outline
 * Tamaños: sm | md | lg
 * ============================================
 */

interface Props {
  variant?: 'primary' | 'dark' | 'whatsapp' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href: string;
  download?: boolean;
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  download = false,
  external = false,
  class: className = ''
} = Astro.props;

// Si es externo (WhatsApp, redes), abre en nueva pestaña con seguridad
const linkAttrs = external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

  <a
  href={href} class={`btn btn--${variant} btn--${size} ${className}`}
  download={download}
  {...linkAttrs}
>
  <slot />
</a>
<style>
  /* ============================================
     BUTTON.CSS — Sweep hover (barrido izq→der)
     Mobile-First + tipografía fluida
     ============================================ */

  .btn {
    position: relative;
    overflow: hidden;      /* oculta la capa de barrido fuera */
    isolation: isolate;    /* el ::before no escapa del botón */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
    text-align: center;
    border-radius: 5px;
    cursor: pointer;
    transition: transform 0.35s ease;
    white-space: nowrap;
    line-height: 1;
  }

  /* --- Capa de barrido: entra desde la izquierda --- */
  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--sweep, rgba(8, 52, 147, 0.2));
    transform: translateX(-101%);
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn:hover::before {
    transform: translateX(0);
  }

  .btn:active {
    transform: translateY(0);
  }

  /* --- Tamaños (fluidos con clamp) --- */
  .btn--sm {
    padding: 0.8rem 1.7rem;
    font-size: clamp(0.8rem, 0.75rem + 0.2vw, 0.9rem);
  }

  .btn--md {
    padding: 16px 32px;
    font-size: clamp(0.9rem, 0.85rem + 0.25vw, 1rem);
  }

  .btn--lg {
    padding: 1.15rem 3.8rem;
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.15rem);
  }

  /* --- Variantes (cada una define su color de barrido) --- */

  /* Primary: naranja, SIN glow (el sweep es el protagonista) */
  .btn--primary {
    --sweep: #FE5000; 
    background-color: var(--color-secondary);
    color: #fff;
  }

  /* Dark: azul noche */
  .btn--dark {
    --sweep: var(--color-primary-alternativy);
    background-color: var(--color-primary);
    color: #fff;
  }

  /* WhatsApp: verde oficial*/
  .btn--whatsapp {
    --sweep: #09a44f;
    background-color: #25D366;
    color: #fff;
  }

  /* Outline: barrido blanco + texto cambia a azul */
  .btn--outline {
    --sweep: #fff;
    background-color: transparent;
    color: #fff;
    border: 2px solid #fff;
  }

  .btn--outline:hover {
    color: var(--color-primary);
  }

  /* --- Accesibilidad --- */
  .btn:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn::before {
      transition: none;
    }

    .btn:hover {
      transform: none;
    }
  }
</style>