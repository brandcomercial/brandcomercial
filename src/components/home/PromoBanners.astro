---
/**
 * PromoBanners.astro — 2 banners promocionales 50/50 (v3)
 * ============================================
 * - Clases por tema para controlar cada imagen libremente
 * - Promo 1 (--print): sobresale 40px solo por abajo
 * - Promo 2 (--install): sobresale 40px arriba + 20px izquierda, pegada al fondo
 * - Animación escalonada: título 0.2s, texto 0.4s (no en bloque)
 * - Hover en imágenes: brightness + saturate
 * ============================================
 */
import { siteConfig } from '../../config/site';

// Tema visual por banner (controla posición/tamaño de su imagen)
const themes = ['promo-banner--print', 'promo-banner--install'];

const banners = siteConfig.promoBanners;
---

<section class="promo" aria-label="Promociones destacadas">
  <div class="promo__container">
    {banners.map((banner, i) => (
      <article
        class={`promo-banner ${themes[i] ?? ''} ${i % 2 === 1 ? 'promo-banner--reverse' : ''}`}
        data-animate={i % 2 === 1 ? 'right' : 'left'}
      >
        <div class="promo-banner__content">
          <h3 class="promo-banner__title">{banner.title}</h3>
          <p class="promo-banner__text" set:html={banner.text}></p>
        </div>
        <div class="promo-banner__media">
          <img src={banner.image} alt={banner.title} loading="lazy" />
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* ============================================
     PROMO.CSS v3 — Control independiente por banner
     ============================================ */

  .promo {
    padding: 1rem 0 4rem;
    background-color: var(--color-bg);
  }

  .promo__container {
    width: var(--container-width);
    max-width: var(--container-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  /* --- BASE (móvil): columnas, sin absolute --- */
  .promo-banner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    background-color: var(--color-banner);
    border-radius: 1rem;
    overflow: hidden;
  }

  .promo-banner__content {
    padding: 2.5rem 1.5rem 1.5rem;
    text-align: center;
    color: #fff;
  }

  .promo-banner__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.4rem);
    line-height: 1.15;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 1rem;
  }

  .promo-banner__text {
    font-size: clamp(0.9rem, 0.85rem + 0.3vw, 1.05rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    max-width: 460px;
    margin: 0 auto;
  }

  .promo-banner__text :global(.promo-highlight) {
    color: #FACC15;
    font-weight: 600;
  }

  .promo-banner__media {
    padding: 0 1.5rem 0;
  }

  .promo-banner__media img {
    display: block;
    width: min(100%, 420px);
    margin: 0 auto;
    transition: filter 0.4s ease;
    vertical-align: bottom;
  }

  /* --- DESKTOP (≥1024px): 50/50 --- */
  @media (min-width: 1024px) {
    .promo-banner {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      min-height: 380px;
      overflow: visible;
    }

    .promo-banner__content {
      padding: 3rem;
      text-align: left;
    }

    .promo-banner__text {
      margin: 0;
    }

    .promo-banner__media {
      position: relative;
      height: 100%;
      padding: 0;
    }

    /* Base común para imágenes absolutas */
    .promo-banner__media img {
      position: absolute;
      width: auto;
      max-width: 95%;
      object-fit: contain;
      filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.25));
      transition: filter 0.4s ease;
    }

    /* PROMO 1: más pequeña, sobresale SOLO 40px por abajo */
    .promo-banner--print .promo-banner__media img {
      bottom: -40px;
      right: 70px;
      height: 95%; /* ← ajustar tamaño libremente */
    }

    /* PROMO 2: sobresale 40px arriba + 20px izquierda, pegada     /* PROMO 2: anclaje con flex (estable en TODOS los anchos) */
    .promo-banner--install .promo-banner__media {
      display: flex;
      align-items: flex-end;      /* Pega la imagen al FONDO de la tarjeta */
      justify-content: flex-start;
      align-self: stretch;        /* Llena la altura completa de la tarjeta */
    }

    .promo-banner--install .promo-banner__media img {
      position: static;
      height: calc(100%, + 20px);
      width: auto;
      max-width: 95%;
      object-fit: contain;
      margin-left: -40px;
      margin-bottom: 0px;
    }

    /* Promo invertida: imagen a la izquierda */
    .promo-banner--reverse .promo-banner__content { order: 2; }
    .promo-banner--reverse .promo-banner__media { order: 1; }
  }

  /* --- Hover profesional en imágenes --- */
  .promo-banner:hover .promo-banner__media img {
    filter: drop-shadow(0 15px 30px rgba(3, 26, 140, 0.2)) brightness(0.85) saturate(1.3);
  }

  /* --- Animación de la tarjeta: slide desde los lados --- */
  .promo-banner[data-animate] {
    opacity: 0;
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .promo-banner[data-animate='left'] {
    transform: translateX(-60px);
  }

  .promo-banner[data-animate='right'] {
    transform: translateX(60px);
  }

  .promo-banner[data-animate].is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  /* --- Animación escalonada: título y texto desde abajo (NO en bloque) --- */
  .promo-banner__title,
  .promo-banner__text {
    opacity: 0;
    transform: translateY(20px);
  }

  .promo-banner.is-visible .promo-banner__title {
    animation: fadeSlideUp 0.6s ease forwards 0.2s;
  }

  .promo-banner.is-visible .promo-banner__text {
    animation: fadeSlideUp 0.6s ease forwards 0.4s;
  }

  @keyframes fadeSlideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  import { initScrollReveal } from '../../utils/scrollReveal';
  document.addEventListener('DOMContentLoaded', () => initScrollReveal());
</script>