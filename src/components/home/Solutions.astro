---
/**
 * Solutions.astro — Carrusel de 3 tarjetas v3 (final)
 * ============================================
 * - Tarjetas verticales con ícono de huevo superpuesto
 * - Carrusel sin flechas laterales, indicadores rectangulares abajo
 * - Overflow hidden (sin bordes feos en tablet/móvil)
 * - Animaciones al scroll en todos los dispositivos
 * - Barra animada: línea 4px + punto lento (4s)
 * ============================================
 */
import { siteConfig } from '../../config/site';
import { ArrowRight, Wrench, Package, Palette } from 'lucide-astro';

const iconMap: Record<string, any> = {
  'wrench': Wrench,
  'package': Package,
  'palette': Palette
};

const solutions = siteConfig.solutions.map((solution) => ({
  ...solution,
  Icon: iconMap[solution.icon] || Wrench
}));
---

<section class="solutions" aria-label="Nuestras soluciones">
  <div class="solutions__container">
    <!-- Encabezado con barra animada -->
    <header class="solutions__header" data-animate>
      <p class="solutions__eyebrow">Lo que hacemos</p>
      <h2 class="solutions__title">Nuestras soluciones</h2>
      <div class="solutions__bar">
        <span class="solutions__bar-line"></span>
        <span class="solutions__bar-dot"></span>
      </div>
    </header>

    <!-- Carrusel -->
    <div class="solutions__carousel">
      <div class="solutions__track" id="solutions-track">
        {solutions.map((solution, i) => (
          <a 
            href={solution.url} 
            class="solution-card"
            data-animate
            data-delay={i * 150}
          >
            <div class="solution-card__media">
              <img 
                src={solution.image} 
                alt={solution.title} 
                width="600" 
                height="400" 
                loading="lazy" 
              />
            </div>
            <div class="solution-card__body">
              <div class="solution-card__icon">
                <solution.Icon size={28} />
              </div>
              <h3 class="solution-card__title">{solution.title}</h3>
              <p class="solution-card__text">{solution.text}</p>
              <span class="solution-card__link" data-animate-link>
                Ver más <ArrowRight size={18} />
              </span>
            </div>
            <span class="solution-card__border"></span>
          </a>
        ))}
      </div>
    </div>

    <!-- Indicadores rectangulares debajo -->
    <div class="solutions__indicators" role="tablist" aria-label="Seleccionar slide">
      {solutions.map((_, i) => (
        <button
          class={`solutions__indicator ${i === 0 ? 'is-active' : ''}`}
          data-index={i}
          role="tab"
          aria-label={`Ir a la tarjeta ${i + 1}`}
          aria-selected={i === 0}
        ></button>
      ))}
    </div>
  </div>
</section>

<style>
  /* ============================================
     SOLUTIONS.CSS v3 — Final
     ============================================ */

  .solutions {
    padding: 4rem 0;
    background-color: var(--color-bg);
    overflow: hidden;
  }

  .solutions__container {
    width: var(--container-width);
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  /* --- Encabezado con barra animada --- */
  .solutions__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
  }

  .solutions__eyebrow {
    font-family: var(--font-heading);
    font-size: clamp(0.8rem, 0.75rem + 0.2vw, 0.95rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    margin-bottom: 0.5rem;
  }

  .solutions__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.2rem + 2.5vw, 3rem);
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  /* Barra animada: línea 4px naranja + punto azul lento (4s) */
  .solutions__bar {
    position: relative;
    width: 120px;
    height: 4px;
    margin: 0 auto;
    background-color: var(--color-alternativy-secondary);
    border-radius: 4px;
  }

  .solutions__bar-dot {
    position: absolute;
    top: 50%;
    left: 0;
    width: 10px;
    height: 10px;
    background-color: var(--color-primary);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: barSlide 5s ease-in-out infinite;
  }

  @keyframes barSlide {
    0%, 100% { left: 0; }
    50% { left: 100%; }
  }

  /* --- Carrusel --- */
  .solutions__carousel {
    position: relative;
    overflow: hidden; /* Sin bordes feos */
  }

  .solutions__track {
    display: flex;
    gap: 1.5rem;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Tarjeta vertical */
  .solution-card {
    flex: 0 0 100%;
    min-width: 0;
    display: block;
    background-color: #fff;
    border-radius: 0.75rem;
    border: 2px solid rgba(10,25,47,0.08);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(10, 25, 47, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    color: inherit;
    position: relative;
  }

  @media (min-width: 768px) {
    .solution-card {
      flex: 0 0 calc((100% - 1.5rem) / 2);
    }
  }

  @media (min-width: 1024px) {
    .solution-card {
      flex: 0 0 calc((100% - 3rem) / 3);
    }
  }

  .solution-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 35px rgba(10, 25, 47, 0.15);
    border-color: rgba(10,25,47,0.1);
}

  /* Imagen vertical (260px) con zoom */
  .solution-card__media {
    height: 260px;
    overflow: hidden;
    background: linear-gradient(135deg, #0A192F 0%, #1E3A5F 100%);
  }

  .solution-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .solution-card:hover .solution-card__media img {
    transform: scale(1.08);
  }

  /* Cuerpo de la tarjeta */
  .solution-card__body {
    padding: 2.5rem 1.5rem 1.5rem; /* Padding superior mayor para el ícono */
    position: relative;
  }

  /* Ícono de huevo/gota en body con margen negativo */
  .solution-card__icon {
    position: absolute;
    top: -32px;
    left: 1.5rem;
    width: 70px;
    height: 70px;
    background-color: var(--color-secondary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index: 2;
  }

  .solution-card:hover .solution-card__icon {
    background-color: var(--color-primary);
    transform: scale(1.1) rotate(5deg);
  }

  .solution-card__title {
    font-family: var(--font-heading);
    font-size: clamp(1.05rem, 1rem + 0.2vw, 1.2rem);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .solution-card__text {
    font-size: clamp(0.85rem, 0.8rem + 0.2vw, 0.95rem);
    line-height: 1.5;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  /* Link "Ver más" con flecha suave (0.5s) */
  .solution-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-secondary);
    transition: gap 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .solution-card:hover .solution-card__link {
    gap: 0.8rem;
  }

  /* Borde inferior que aparece al hover */
  .solution-card__border {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 3px;
    background-color: var(--color-secondary);
    transition: width 0.4s ease;
  }

  .solution-card:hover .solution-card__border {
    width: 100%;
  }

  /* --- Indicadores rectangulares debajo --- */
  .solutions__indicators {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .solutions__indicator {
    width: 32px;
    height: 4px;
    border-radius: 4px;
    background-color: rgba(10, 25, 47, 0.2);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    outline: none;
  }

  .solutions__indicator.is-active {
    width: 48px;
    background-color: var(--color-secondary);
  }

  .solutions__indicator:hover {
    background-color: rgba(10, 25, 47, 0.4);
  }

  .solutions__indicator:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: 3px;
  }

  /* --- Animaciones al scroll (todos los dispositivos) --- */
  [data-animate] {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  [data-animate].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .solution-card[data-animate] {
    transform: translateX(-40px);
  }

  .solution-card[data-animate].is-visible {
    transform: translateX(0);
  }

  [data-animate-link] {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease 0.3s, transform 0.5s ease 0.3s;
  }

  .solution-card.is-visible [data-animate-link] {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('solutions-track');
    const indicators = document.querySelectorAll('.solutions__indicator');
    const cards = document.querySelectorAll('.solution-card');

    if (!track || cards.length === 0) return;

    let currentIndex = 0;
    let autoTimer: ReturnType<typeof setInterval>;

    const getVisibleCount = () => {
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 768) return 2;
      return 1;
    };

    const goTo = (index: number) => {
      const visible = getVisibleCount();
      const maxIndex = Math.max(0, cards.length - visible);
      currentIndex = Math.min(Math.max(index, 0), maxIndex);

      const cardWidth = cards[0].offsetWidth;
      const gap = 24;
      const offset = currentIndex * (cardWidth + gap);
      track.style.transform = `translateX(-${offset}px)`;

      // Actualizar indicadores
      indicators.forEach((ind, i) => {
        const active = i === currentIndex;
        ind.classList.toggle('is-active', active);
        ind.setAttribute('aria-selected', String(active));
      });
    };

    const next = () => {
      const visible = getVisibleCount();
      const maxIndex = Math.max(0, cards.length - visible);
      if (currentIndex >= maxIndex) {
        goTo(0);
      } else {
        goTo(currentIndex + 1);
      }
    };

    const prev = () => {
      const visible = getVisibleCount();
      const maxIndex = Math.max(0, cards.length - visible);
      if (currentIndex <= 0) {
        goTo(maxIndex);
      } else {
        goTo(currentIndex - 1);
      }
    };

    const startAuto = () => {
      stopAuto();
      autoTimer = setInterval(next, 4000);
    };
    const stopAuto = () => clearInterval(autoTimer);

    // Eventos de indicadores
    indicators.forEach((ind) => {
      ind.addEventListener('click', () => {
        goTo(Number(ind.getAttribute('data-index')));
        startAuto();
      });
    });

    // Pausar al pasar el mouse
    const carousel = track.closest('.solutions__carousel');
    carousel?.addEventListener('mouseenter', stopAuto);
    carousel?.addEventListener('mouseleave', startAuto);

    // Swipe táctil
    let touchStartX = 0;
    track.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      stopAuto();
    }, { passive: true });
    track.addEventListener('touchend', (e) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) diff > 0 ? next() : prev();
      startAuto();
    });

    window.addEventListener('resize', () => goTo(currentIndex));

    // --- IntersectionObserver: animaciones al scroll (todos los dispositivos) ---
    const animateElements = document.querySelectorAll('[data-animate]');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const delay = entry.target.getAttribute('data-delay') || 0;
          setTimeout(() => {
            entry.target.classList.add('is-visible');
          }, Number(delay));
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });

    animateElements.forEach((el) => observer.observe(el));

    startAuto();
  });
</script>