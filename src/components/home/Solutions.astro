---
/**
 * Solutions.astro — Sección de soluciones (versión refactorizada)
 * ============================================
 * Ahora es una sección "delgada": solo compone
 * - Encabezado (eyebrow + título + barra animada)
 * - Carousel (mecanismo genérico)
 * - SolutionCard (tarjeta reutilizable)
 *
 * La lógica del carrusel vive en Carousel.astro
 * El diseño de la tarjeta vive en SolutionCard.astro
 * Las animaciones al scroll viven en scrollReveal.ts
 * ============================================
 */
import { siteConfig } from '../../config/site';
import Carousel from '../ui/Carousel.astro';
import SolutionCard from '../cards/SolutionCard.astro';

const solutions = siteConfig.solutions;
---

<section class="solutions" aria-label="Nuestras soluciones">
  <div class="solutions__container">
    <!-- Encabezado con barra animada -->
    <header class="solutions__header" data-animate>
      <p class="solutions__eyebrow">Lo que hacemos</p>
      <h2 class="solutions__title">Nuestras soluciones</h2>
      <div class="solutions__bar">
        <span class="solutions__bar-dot"></span>
      </div>
    </header>

    <!-- Carrusel genérico con tarjetas de solución -->
    <Carousel 
      id="solutions" 
      itemsPerView={{ mobile: 1, tablet: 2, desktop: 3 }} 
      autoplay={4000}
    >
      {solutions.map((solution, i) => (
        <SolutionCard solution={solution} index={i} />
      ))}
    </Carousel>
  </div>
</section>

<style>
  /* ============================================
     SOLUTIONS.CSS — Solo estilos de la SECCIÓN
     (el carrusel y la tarjeta tienen sus propios estilos)
     ============================================ */

  .solutions {
    padding: 4rem 0;
    background-color: var(--color-bg);
    overflow: hidden;
  }

  .solutions__container {
    width: var(--container-width);
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  /* Encabezado */
  .solutions__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
  }

  .solutions__eyebrow {
    font-family: var(--font-heading);
    font-size: clamp(0.8rem, 0.75rem + 0.2vw, 0.95rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    margin-bottom: 0.5rem;
  }

  .solutions__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.2rem + 2.5vw, 3rem);
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  /* Barra animada: línea naranja + punto azul lento */
  .solutions__bar {
    position: relative;
    width: 120px;
    height: 4px;
    margin: 0 auto;
    background-color: var(--color-secondary);
    border-radius: 4px;
  }

  .solutions__bar-dot {
    position: absolute;
    top: 50%;
    left: 0;
    width: 10px;
    height: 10px;
    background-color: var(--color-primary);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: barSlide 4s ease-in-out infinite;
  }

  @keyframes barSlide {
    0%, 100% { left: 0; }
    50% { left: 100%; }
  }

  /* Animación del encabezado al scroll */
  .solutions__header[data-animate] {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .solutions__header[data-animate].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  import { initScrollReveal } from '../../utils/scrollReveal';
  document.addEventListener('DOMContentLoaded', () => initScrollReveal());
</script>