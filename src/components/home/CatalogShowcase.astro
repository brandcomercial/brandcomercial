---
/**
 * CatalogShowcase.astro — v7 (alturas determinísticas)
 * ============================================
 * - Variables --slider-h y --card-h por breakpoint
 * - Cálculo: 2 cards + gap = altura del slider (proporción garantizada)
 * - Sin aspect-ratio ni stretch: valores fijos ajustables
 * ============================================
 */
import { siteConfig } from '../../config/site';
import Button from '../ui/Button.astro';

const slides = siteConfig.catalogSlides;
const cards = siteConfig.catalogCards;
---

<section class="catalog" aria-label="Catálogo destacado">
  <div class="catalog__container">
    <!-- Slider -->
    <div class="catalog-slider">
      <div class="catalog-slider__track" id="catalog-track">
        {slides.map((slide, i) => (
          <div class={`catalog-slide ${i === 0 ? 'is-active' : ''}`} data-index={i}>
            <div class="catalog-slide__content">
              <h3 class="catalog-slide__title">{slide.title}</h3>
              <p class="catalog-slide__text">{slide.text}</p>
              <Button href={slide.url} variant="primary" size="sm">{slide.cta}</Button>
            </div>
            <div class="catalog-slide__media">
              <img src={slide.image} alt={slide.title} loading="lazy" />
            </div>
          </div>
        ))}
      </div>
      <div class="catalog-slider__dots">
        {slides.map((_, i) => (
          <button
            class={`catalog-slider__dot ${i === 0 ? 'is-active' : ''}`}
            data-index={i}
            aria-label={`Ir al slide ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>

    <!-- Cards -->
    <div class="catalog__cards">
      {cards.map((card) => (
        <article class={`catalog-card catalog-card--${card.theme}`}>
          <div class="catalog-card__content">
            <h4 class="catalog-card__title">{card.title}</h4>
            <p class="catalog-card__text">{card.text}</p>
            <Button 
              href={card.url} 
              variant={card.theme === 'orange' ? 'dark' : 'primary'} 
              size="sm"
            >
              {card.cta}
            </Button>
          </div>
          <div class="catalog-card__media">
            <img src={card.image} alt={card.title} loading="lazy" />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ============================================
     CATALOG.CSS v7 — Alturas determinísticas
     ============================================ */

  .catalog {
    --slider-h: 220px;
    --card-h: 190px;
    padding: 2rem 0rem;
    background-color: var(--color-bg);
    margin-top: -30px;
  }

  @media (min-width: 480px) {
    .catalog { --slider-h: 260px; --card-h: 180px; }
  }

  @media (min-width: 768px) {
    .catalog { --slider-h: 300px; --card-h: 210px; }
  }

  @media (min-width: 961px) {
    .catalog { --slider-h: 340px; --card-h: 160px; }
  }

  @media (min-width: 1280px) {
    .catalog { --slider-h: 400px; --card-h: 190px; }
  }

  @media (min-width: 1440px) {
    .catalog { --slider-h: 440px; --card-h: 210px; }
  }

  .catalog__container {
    width: var(--container-width);
    max-width: var(--container-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .catalog__container { gap: 1.25rem; }
  }

  @media (min-width: 961px) {
    .catalog__container {
      grid-template-columns: 1.9fr 1fr;
      align-items: start;
    }
  }

  /* --- SLIDER --- */
  .catalog-slider {
    position: relative;
    border-radius: .65rem;
    overflow: hidden;
    background: linear-gradient(135deg, #0A192F 0%, #16324F 100%);
    height: var(--slider-h);
  }

  .catalog-slider__track {
    display: flex;
    height: 100%;
    transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .catalog-slide {
    flex: 0 0 100%;
    height: 100%;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 0.75rem;
    align-items: center;
    padding: 1rem 1.5rem;
  }

  @media (min-width: 768px) {
    .catalog-slide { padding: 1.5rem 1.5rem 2.5rem; gap: 1.25rem; }
  }

  @media (min-width: 1280px) {
    .catalog-slide { padding: 2rem 2rem 3rem; gap: 1.5rem; }
  }

  @media (min-width: 1440px) {
    .catalog-slide { padding: 2.5rem 3rem 3.25rem; }
  }

  .catalog-slide__content { color: #fff; }

  .catalog-slide__title {
    font-family: var(--font-display);
    font-size: 0.8rem;
    line-height: 1.15;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 0.4rem;
  }

  @media (min-width: 768px) { .catalog-slide__title { font-size: 1.4rem; } }
  @media (min-width: 961px) { .catalog-slide__title { font-size: 1.6rem; } }
  @media (min-width: 1280px) { .catalog-slide__title { font-size: 2rem; } }

  
  @media (min-width: 1440px) { .catalog-slide__title { font-size: 2.4rem; } }

  .catalog-slide__text {
    font-size: 0.6rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 1rem;
    max-width: 420px;
  }

  @media (min-width: 768px) { .catalog-slide__text { font-size: 0.85rem; } }
  @media (min-width: 1280px) { .catalog-slide__text { font-size: 1rem; } }

  /* Botón del slider compacto en móvil */
  @media (max-width: 479px) {
    .catalog-slide__content :global(.button) {
      padding: 0.5rem 1.1rem;
      font-size: 0.8rem;
    }
  }

  .catalog-slide__media {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .catalog-slide__media img {
    max-width: 100%;
    max-height: 90%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Dots pequeños */
  .catalog-slider__dots {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.4rem;
    z-index: 10;
  }

  .catalog-slider__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.35);
    border: none;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .catalog-slider__dot.is-active {
    width: 22px;
    background-color: var(--color-secondary);
  }

  /* --- CARDS --- */
  .catalog__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) and (max-width: 960px) {
    .catalog__cards {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
  }

  @media (min-width: 961px) {
    .catalog__cards {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
  }

  .catalog-card {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    border-radius: 0.65rem;
    overflow: hidden;
    height: var(--card-h);
  }

  .catalog-card--orange { background-color: var(--color-secondary); }
  .catalog-card--blue { background-color: #DCEBFA; }

  .catalog-card__content {
    padding: 1.3rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.15rem;
    height: 100%;
  }

  .catalog-card--orange .catalog-card__content { color: #fff; }
  .catalog-card--blue .catalog-card__content { color: var(--color-primary); }

  .catalog-card__title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.25;
  }

  @media (min-width: 1280px) { .catalog-card__title { font-size: 1.1rem; } }

  .catalog-card__text {
    font-size: 0.72rem;
    line-height: 1.4;
    opacity: 0.9;
  }

  @media (min-width: 1280px) { .catalog-card__text { font-size: 0.82rem; } }

  .catalog-card__media {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    overflow: hidden;
  }

  .catalog-card__media img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .catalog-card:hover .catalog-card__media img {
    transform: scale(1.08);
  }

  /* --- ANIMACIONES --- */
  .catalog-slide__title,
  .catalog-slide__text {
    opacity: 0;
    transform: translateX(-40px);
  }

  .catalog-slide__content :global(.button) {
    opacity: 0;
    transform: translateY(30px);
  }

  .catalog-slide__media img {
    opacity: 0;
    transform: translateX(40px) scale(0.95);
  }

  .catalog-slide.is-active .catalog-slide__title {
    animation: slideInLeft 0.8s cubic-bezier(0.65, 0, 0.35, 1) forwards 0.2s;
  }

  .catalog-slide.is-active .catalog-slide__text {
    animation: slideInLeft 0.8s cubic-bezier(0.65, 0, 0.35, 1) forwards 0.35s;
  }

  .catalog-slide.is-active .catalog-slide__content :global(.button) {
    animation: slideInUp 0.8s cubic-bezier(0.65, 0, 0.35, 1) forwards 0.5s;
  }

  .catalog-slide.is-active .catalog-slide__media img {
    animation: slideInRight 0.8s cubic-bezier(0.65, 0, 0.35, 1) forwards 0.3s;
  }

    /* Rango 961-1279px: contenido de cards más compacto (menos apretado) */
  @media (min-width: 961px) and (max-width: 1279px) {
    .catalog-card__content {
      padding: 0.75rem;
      gap: 0.25rem;
    }

    .catalog-card__title {
      font-size: 0.85rem;
    }

    .catalog-card__text {
      font-size: 0.66rem;
    }

    /* Botón más pequeño solo en este rango */
    .catalog-card :global(.button) {
      padding: 0.4rem 0.9rem;
      font-size: 0.72rem;
    }

    .catalog-card__media {
      padding: 0.4rem;
    }
  }
  
  @keyframes slideInLeft { to { opacity: 1; transform: translateX(0); } }
  @keyframes slideInUp { to { opacity: 1; transform: translateY(0); } }
  @keyframes slideInRight { to { opacity: 1; transform: translateX(0) scale(1); } }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('catalog-track');
    const dots = document.querySelectorAll('.catalog-slider__dot');
    const slides = document.querySelectorAll('.catalog-slide');
    if (!track || slides.length === 0) return;

    let currentIndex = 0;
    let autoTimer: ReturnType<typeof setInterval>;

    const goTo = (index: number) => {
      currentIndex = Math.min(Math.max(index, 0), slides.length - 1);
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === currentIndex));
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === currentIndex));
    };

    const next = () => goTo(currentIndex >= slides.length - 1 ? 0 : currentIndex + 1);
    const startAuto = () => { stopAuto(); autoTimer = setInterval(next, 5000); };
    const stopAuto = () => clearInterval(autoTimer);

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        goTo(Number(dot.getAttribute('data-index')));
        startAuto();
      });
    });

    const slider = track.closest('.catalog-slider');
    slider?.addEventListener('mouseenter', stopAuto);
    slider?.addEventListener('mouseleave', startAuto);

    let touchStartX = 0;
    track.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      stopAuto();
    }, { passive: true });
    track.addEventListener('touchend', (e) => {
      const diff = touchStartX - (e as TouchEvent).changedTouches[0].clientX;
      if (Math.abs(diff) > 50) (diff > 0 ? goTo(currentIndex + 1) : goTo(currentIndex - 1));
      startAuto();
    });

    goTo(0);
    startAuto();
  });
</script>