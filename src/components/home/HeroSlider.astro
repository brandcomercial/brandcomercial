---
import { siteConfig } from '../../config/site';
import Button from '../Button.astro';
import { ChevronLeft, ChevronRight } from 'lucide-astro';

const slides = siteConfig.heroSlides;
---

<div class="hero-wrapper">
  <section class="hero" aria-label="Presentación principal" aria-roledescription="carrusel">
    <div class="hero__track" id="hero-track">
      {slides.map((slide, i) => (
        <article 
          class={`hero__slide ${slide.theme} ${i === 0 ? 'is-active' : ''}`}
          aria-hidden={i !== 0}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} de ${slides.length}`}
        >
          <div class="hero__content">
            <p class="hero__eyebrow">{slide.eyebrow}</p>
            <h1 class="hero__title">{slide.title}</h1>
            <p class="hero__text">{slide.text}</p>
            <Button href={slide.url} variant="primary" size="md" class="hero__cta">
              {slide.cta}
            </Button>
          </div>
          <div class="hero__image">
            <img 
              src={slide.image} 
              alt={slide.title}
              width="600"
              height="400"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
        </article>
      ))}
    </div>

    <button class="hero__arrow hero__arrow--prev" id="hero-prev" aria-label="Slide anterior">
      <ChevronLeft size={24} />
    </button>
    <button class="hero__arrow hero__arrow--next" id="hero-next" aria-label="Slide siguiente">
      <ChevronRight size={24} />
    </button>

    <div class="hero__dots" role="tablist" aria-label="Seleccionar slide">
      {slides.map((_, i) => (
        <button
          class={`hero__dot ${i === 0 ? 'is-active' : ''}`}
          data-index={i}
          role="tab"
          aria-label={`Ir al slide ${i + 1}`}
          aria-selected={i === 0}
        ></button>
      ))}
    </div>
  </section>
</div>

<style>
  .hero-wrapper {
    padding-top: 80px;
    background-color: var(--color-bg);
  }

  .hero {
    position: relative;
    width: 85%;
    max-width: 1400px;
    margin: 0 auto;
    height: clamp(420px, 65vh, 600px);
    overflow: hidden;
    border-radius: 1.0rem;
  }

  /* Track: crossfade entre slides*/
  .hero__track {
    position: relative;
    height: 100%;
  }

  /* Cada slide: posición absoluta para crossfade */
  .hero__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 3rem;
    gap: 2rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease, visibility 0.8s ease;
  }

  .hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  .slide--print {
    background: linear-gradient(135deg, #0A192F 0%, #1E3A5F 100%);
  }
  .slide--install {
    background: linear-gradient(135deg, #1E3A5F 0%, #FF6B35 100%);
  }
  .slide--brand {
    background: linear-gradient(135deg, #0A192F 0%, #2D3748 100%);
  }

  /* --- Animación 1: Fade-in suave para eyebrow, title, text --- */
  .hero__content {
    flex: 1;
    max-width: 560px;
    color: #fff;
  }

  .hero__eyebrow,
  .hero__title,
  .hero__text {
    opacity: 0;
    filter: blur(1px);
    transform: translateY(5px);
  }

  .hero__slide.is-active .hero__eyebrow {
    animation: fadeInSoft 0.8s ease forwards 0.3s;
  }

  .hero__slide.is-active .hero__title {
    animation: fadeInSoft 0.8s ease forwards 0.45s;
  }

  .hero__slide.is-active .hero__text {
    animation: fadeInSoft 0.8s ease forwards 0.6s;
  }

  @keyframes fadeInSoft {
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  .hero__eyebrow {
    font-family: var(--font-heading);
    font-size: clamp(0.8rem, 0.75rem + 0.2vw, 0.95rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    margin-bottom: 0.75rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    line-height: 1.1;
    color: #fff;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .hero__text {
    font-size: clamp(0.95rem, 0.9rem + 0.3vw, 1.15rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 1.5rem;
  }

  /* --- Animación 3: Fade-in suave para botón --- */
  .hero__cta {
    min-width: 180px;
    opacity: 0;
    filter: blur(6px);
  }

  .hero__slide.is-active .hero__cta {
    animation: fadeInSoft 0.7s ease forwards 0.75s;
  }

  /* --- Animación 2: Slide desde la derecha para imagen --- */
  .hero__image {
    display: none;
    flex: 1;
    max-width: 45%;
    opacity: 0;
    transform: translateX(60px);
  }

  .hero__slide.is-active .hero__image {
    animation: slideInRight 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards 0.5s;
  }

  @keyframes slideInRight {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .hero__image img {
    width: 100%;
    height: auto;
    object-fit: contain;
    opacity: 0.9;
    filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.3));
  }

  @media (min-width: 1024px) {
    .hero__image {
      display: block;
    }
  }

  /* --- Flechas --- */
  .hero__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.15);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
    transition: background-color 0.3s ease, transform 0.2s ease;
    z-index: 10;
    cursor: pointer;
    border: none;
    outline: none;
  }

  .hero__arrow:hover {
    background-color: var(--color-secondary);
    transform: translateY(-50%) scale(1.1);
  }

  .hero__arrow:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: 3px;
  }

  .hero__arrow--prev { left: 1rem; }
  .hero__arrow--next { right: 1rem; }

  @media (min-width: 768px) {
    .hero__arrow--prev { left: 1.5rem; }
    .hero__arrow--next { right: 1.5rem; }
  }

  /* --- Dots --- */
  .hero__dots {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    z-index: 10;
  }

  .hero__dot {
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    background-color: rgba(255, 255, 255, 0.4);
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
    outline: none;
  }

  .hero__dot.is-active {
    width: 32px;
    background-color: var(--color-secondary);
  }

  .hero__dot:hover {
    background-color: rgba(255, 255, 255, 0.7);
  }

  .hero__dot:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .hero {
      width: 92%;
      height: clamp(380px, 75vh, 480px);
    }

    .hero__slide {
      padding: 1.5rem;
      justify-content: center;
    }

    .hero__content {
      text-align: center;
      max-width: 100%;
    }

    .hero__cta {
      min-width: 160px;
    }

    .hero__dots {
      bottom: 2rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('hero-track');
    const prevBtn = document.getElementById('hero-prev');
    const nextBtn = document.getElementById('hero-next');
    const dots = document.querySelectorAll('.hero__dot');
    const slides = document.querySelectorAll('.hero__slide');

    if (!track || !prevBtn || !nextBtn || slides.length === 0) return;

    let currentIndex = 0;
    const total = slides.length;
    let autoTimer: ReturnType<typeof setInterval>;

    const goTo = (index: number) => {
      // Desactivar slide actual
      slides[currentIndex].classList.remove('is-active');
      slides[currentIndex].setAttribute('aria-hidden', 'true');

      // Calcular nuevo índice (loop infinito)
      currentIndex = (index + total) % total;

      // Activar nuevo slide
      slides[currentIndex].classList.add('is-active');
      slides[currentIndex].setAttribute('aria-hidden', 'false');

      // Actualizar dots
      dots.forEach((dot, i) => {
        const active = i === currentIndex;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', String(active));
      });
    };

    const next = () => goTo(currentIndex + 1);
    const prev = () => goTo(currentIndex - 1);

    const startAuto = () => {
      stopAuto();
      autoTimer = setInterval(next, 5000);
    };
    const stopAuto = () => clearInterval(autoTimer);

    nextBtn.addEventListener('click', () => { next(); startAuto(); });
    prevBtn.addEventListener('click', () => { prev(); startAuto(); });
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        goTo(Number(dot.getAttribute('data-index')));
        startAuto();
      });
    });

    const hero = track.closest('.hero');
    hero?.addEventListener('mouseenter', stopAuto);
    hero?.addEventListener('mouseleave', startAuto);

    let touchStartX = 0;
    track.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      stopAuto();
    }, { passive: true });
    track.addEventListener('touchend', (e) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) diff > 0 ? next() : prev();
      startAuto();
    });

    // Inicializar: activar primer slide
    slides[0].classList.add('is-active');
    slides[0].setAttribute('aria-hidden', 'false');
    startAuto();
  });
</script>