---
/**
 * Intro.astro v2 — Nosotros: introducción a la empresa
 * ============================================
 * Collage superpuesto + slogan + hover servicios refinado
 * Icono: círculo fijo + SVG rota 360° con difuminación
 */
import { siteConfig } from '../../config/site';
import Button from '../ui/Button.astro';
import AnimatedBar from '../ui/AnimatedBar.astro';
import { UserCog } from 'lucide-astro';

const { eyebrow, title, slogan, text, services, cta, image1, image2 } = siteConfig.nosotrosIntro;

const words = (s: string) => s.split(' ').filter(Boolean);
const lines = (s: string) => s.split(/(?<=[.!?…])\s+/).filter(Boolean);

const eyebrowW = words(eyebrow);
const titleW = words(title);
const sloganW = words(slogan);
const textL = lines(text);

const WORD = 0.04;
const LINE = 0.15;

const tEyebrow = 0.1;
const tTitle = tEyebrow + eyebrowW.length * WORD + 0.3;
const tSlogan = tTitle + titleW.length * WORD + 0.3;
const tBar = tSlogan + sloganW.length * WORD + 0.3;
const tImages = tBar + 0.3;
const tText = tBar + 0.5;
const tServices = tText + textL.length * LINE + 0.3;
const tCta = tServices + services.length * LINE + 0.4;
---

<section class="intro" aria-label="Introducción a la empresa">
  <div
    class="intro__container"
    data-animate
    style={`--t-eyebrow: ${tEyebrow}s; --t-title: ${tTitle}s; --t-slogan: ${tSlogan}s; --t-bar: ${tBar}s; --t-images: ${tImages}s; --t-text: ${tText}s; --t-services: ${tServices}s; --t-cta: ${tCta}s;`}
  >
    <div class="intro__content">
      <p class="intro__eyebrow aw aw-down">
        {eyebrowW.map((w, i) => <span class="w" style={`--w: ${i}`}>{w}&nbsp;</span>)}
      </p>

      <p class="intro__slogan aw aw-down">
        {sloganW.map((w, i) => <span class="w" style={`--w: ${i}`}>{w}&nbsp;</span>)}
      </p>

      <h2 class="intro__title aw aw-right">
        {titleW.map((w, i) => {
          const accent = w.startsWith('**') && w.endsWith('**');
          const clean = accent ? w.slice(2, -2) : w;
          return (
            <span class={`w ${accent ? 'w--accent' : ''}`} style={`--w: ${i}`}>
              {clean}&nbsp;
            </span>
          );
        })}
      </h2>


      <AnimatedBar start={tBar} />

      <p class="intro__text al">
        {textL.map((l, i) => <span class="l" style={`--l: ${i}`}>{l}</span>)}
      </p>

      <div class="intro__services">
        <span class="intro__services-icon fade">
          <UserCog size={28} />
        </span>
        <p class="al">
          {services.map((l, i) => <span class="l" style={`--l: ${i}`}>{l}</span>)}
        </p>
      </div>

      <div class="intro__cta anim-left">
        <Button href={cta.url} variant="primary" size="md">{cta.text}</Button>
      </div>
    </div>

    <div class="intro__visual">
      <figure class="intro__fig intro__fig--1 rise">
        <img src={image1} alt="Equipo Brandcomercial en presentación" loading="lazy" />
      </figure>
      <figure class="intro__fig intro__fig--2 rise">
        <img src={image2} alt="Equipo Brandcomercial trabajando en proyecto" loading="lazy" />
      </figure>
    </div>
  </div>
</section>

<style>
  .intro {
    padding: 4rem 0;
    background-color: var(--color-bg);
  }

  .intro__container {
    width: var(--container-width);
    max-width: var(--container-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 961px) {
    .intro__container {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .intro__eyebrow { --start: var(--t-eyebrow); }
  .intro__title { --start: var(--t-title); }
  .intro__slogan { --start: var(--t-slogan); }
  .intro__text { --start: var(--t-text); }
  .intro__services .al { --start: var(--t-services); }
  .intro__services-icon { --start: var(--t-services); }
  .intro__cta { --start: var(--t-cta); }
  .intro__fig--1 { --start: var(--t-images); }
  .intro__fig--2 { --start: calc(var(--t-images) + 0.25s); }

  .aw .w,
  .al .l {
    opacity: 0;
    display: inline-block;
  }

  .al .l { display: block; transform: translateY(20px); }
  .aw-down .w { transform: translateY(-30px); }
  .aw-right .w { transform: translateX(40px); }

  .fade,
  .anim-left,
  .rise { opacity: 0; }

  .anim-left { transform: translateX(-40px); }
  .rise { transform: translateY(40px); }

  .intro__container.is-visible .aw .w {
    animation: appear 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    animation-delay: calc(var(--start) + var(--w) * 0.04s);
  }

  .intro__container.is-visible .al .l {
    animation: appear 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    animation-delay: calc(var(--start) + var(--l) * 0.15s);
  }

  .intro__container.is-visible .anim-left,
  .intro__container.is-visible .rise {
    animation: appear 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    animation-delay: var(--start);
  }

  /* Icono: entrada solo opacity (transform libre para el hover) */
  .intro__container.is-visible .intro__services-icon {
    animation: fadeOnly 0.7s ease forwards;
    animation-delay: var(--start);
  }

  @keyframes appear {
    to { opacity: 1; transform: translate(0, 0); }
  }

  @keyframes fadeOnly {
    to { opacity: 1; }
  }

  .intro__content {
    text-align: left;
  }

  .intro__eyebrow {
    font-family: var(--font-heading);
    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.9rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primary);
  }

  .intro__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.3rem + 2.5vw, 3rem);
    line-height: 1.0;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .w--accent {
    color: var(--color-secondary);
  }

  .intro__slogan {
    font-family: var(--font-display);
    font-size: clamp(0.8rem, 0.75rem + 0.3vw, 0.5rem);
    text-transform: uppercase;
    letter-spacing: 0.6em;
    color: var(--color-primary);
    margin-bottom: 0.6rem;
  }

  .intro__text {
    font-size: clamp(0.85rem, 0.8rem + 0.2vw, 0.95rem);
    line-height: 1.7;
    color: var(--color-text);
    opacity: 0.85;
    margin-bottom: 1.5rem;
  }

  /* --- Bloque servicios --- */
  .intro__services {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
    cursor: default;
  }

  /* Círculo: permanece FIJO, solo invierte colores */
  .intro__services-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: rgba(10, 25, 47, 0.08);
    color: var(--color-primary);
    flex-shrink: 0;
    transition:
      background-color 0.4s ease,
      color 0.4s ease;
  }

  /* SVG: libre para rotar con difuminación */
  .intro__services-icon svg {
    display: block;
    transition: transform 0.5s ease, filter 0.6s ease;
  }

  .intro__services:hover .intro__services-icon {
    background-color: var(--color-secondary);
    color: #fff;
  }

  .intro__services:hover .intro__services-icon svg {
    animation: iconSpin 0.9s cubic-bezier(0.4, 0.1, 0.2, 1);
  }

  @keyframes iconSpin {
    0%   { transform: rotate(0deg);   filter: blur(0);   opacity: 1; }
    50%  { transform: rotate(180deg); filter: blur(2px); opacity: 0.55; }
    100% { transform: rotate(360deg); filter: blur(0);   opacity: 1; }
  }

  .intro__services .al {
    font-size: clamp(0.8rem, 0.75rem + 0.2vw, 0.9rem);
    line-height: 1.6;
    color: var(--color-text);
    opacity: 0.85;
    flex: 1; 
  }

  /* --- Collage superpuesto --- */
  .intro__visual {
    position: relative;
    padding-bottom: 2.5rem;
  }

  .intro__fig {
    overflow: hidden;
    border-radius: 1rem;
    margin: 0;
    box-shadow: 0 15px 40px rgba(10, 25, 47, 0.15);
  }

  .intro__fig--1 {
    width: 82%;
    margin-left: auto;
    aspect-ratio: 1 / 1;
  }

  .intro__fig--2 {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 55%;
    aspect-ratio: 1 / 1;
    z-index: 2;
    box-shadow: 0 20px 50px rgba(10, 25, 47, 0.3);
  }

  @media (max-width: 960px) {
    .intro__fig--1 { width: 90%; }
    .intro__fig--2 { width: 60%; }
  }

  .intro__fig img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .intro__fig:hover img {
    transform: scale(1.06);
  }

  /* --- Botón azul noche --- */
  .intro__cta :global(.btn.btn--primary) {
    background-color: var(--color-primary);
    color: #fff;
    border: 2px solid var(--color-primary);
    box-shadow: none;
  }

  .intro__cta :global(.btn.btn--primary:hover) {
    background-color: #0d2547;
    border-color: #0d2547;
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .aw .w,
    .al .l,
    .fade,
    .anim-left,
    .rise {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }

    .intro__services:hover .intro__services-icon svg {
      animation: none;
    }

    .intro__fig:hover img {
      transform: none;
    }
  }
</style>