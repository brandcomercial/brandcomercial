---
/**
 * ContactBanner.astro — Nosotros: banner CTA de contacto
 * ============================================
 * - Fondo --color-banner + halftone dots + bandas diagonales + cuña oscura
 * - Círculo blanco con teléfono + anillo punteado girando ∞
 * - Teléfono y email clickeables desde siteConfig.contact
 * - Título palabra×palabra | contacto desde la derecha
 */
import { siteConfig } from '../../config/site';
import { Phone } from 'lucide-astro';

const { phone, phoneLink, email, emailLink } = siteConfig.contact;

const words = (s: string) => s.split(' ').filter(Boolean);
const titleW = words('¡Iniciemos el proyecto de tu **negocio**!');

const tTitle = 0.1;
const tIcon = 0.5;
const tContact = 0.7;
---

<section class="banner" aria-label="Inicia tu proyecto con nosotros">
  <!-- Decoración: bandas diagonales -->
  <div class="banner__stripes" aria-hidden="true">
    <span class="banner__stripe banner__stripe--1"></span>
    <span class="banner__stripe banner__stripe--2"></span>
  </div>

  <div
    class="banner__container"
    data-animate
    style={`--t-title: ${tTitle}s; --t-icon: ${tIcon}s; --t-contact: ${tContact}s;`}
  >
    <!-- Título -->
    <h2 class="banner__title aw">
            {titleW.map((w, i) => {
        const accent = w.includes('**');
        const clean = w.replace(/\*\*/g, '');
        return (
          <span class={`w ${accent ? 'w--accent' : ''}`} style={`--w: ${i}`}>
            {clean}&nbsp;
          </span>
        );
      })}
    </h2>

    <!-- Icono teléfono con anillo girando -->
    <div class="banner__icon fade">
      <span class="banner__ring" aria-hidden="true"></span>
      <Phone size={36} />
    </div>

    <!-- Contacto -->
    <div class="banner__contact slide-right">
      <a class="banner__phone" href={phoneLink}>{phone}</a>
      <a class="banner__email" href={emailLink}>{email}</a>
    </div>
  </div>
</section>

<style>
  /* ============================================
     CONTACT-BANNER.CSS — CTA con anillo giratorio
     ============================================ */

  .banner {
    position: relative;
    overflow: hidden;
    background-color: var(--color-banner);
    padding: 4.5rem 0;
    margin-bottom: 0;
  }

  /* Puntos halftone (más visibles a la derecha) */
  .banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.18) 1.5px, transparent 1.5px);
    background-size: 14px 14px;
    -webkit-mask-image: linear-gradient(90deg, transparent 25%, #000 70%);
    mask-image: linear-gradient(90deg, transparent 25%, #000 70%);
    pointer-events: none;
  }

  /* Cuña oscura diagonal */
  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 45%, rgba(10, 25, 47, 0.45) 45.5%);
    pointer-events: none;
  }

  /* Bandas diagonales redondeadas */
  .banner__stripes {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .banner__stripe {
    position: absolute;
    top: -30%;
    width: 140px;
    height: 160%;
    border-radius: 999px;
    transform: rotate(25deg);
    background: rgba(255, 255, 255, 0.08);
  }

  .banner__stripe--1 { left: 6%; }

  .banner__stripe--2 {
    left: 16%;
    background: rgba(255, 255, 255, 0.12);
  }

  /* --- Contenido --- */
  .banner__container {
    position: relative;
    z-index: 1;
    width: var(--container-width);
    max-width: var(--container-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    justify-items: center;
    text-align: center;
  }

    @media (min-width: 961px) {
    .banner__container {
      grid-template-columns: 1fr auto 1fr;
      justify-items: center;
      text-align: center;
      gap: 3rem;
    }
  }

  @media (min-width: 1200px) {
    .banner__container {
      justify-items: start;
      text-align: left;
    }

    .banner__contact {
      justify-self: end;
    }
  }

  /* --- Título --- */
  .banner__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 2.2vw, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    color: #fff;
  }

  .w--accent {
    color: var(--color-secondary);
  }

  /* --- Icono + anillo punteado girando ∞ --- */
  .banner__icon {
    position: relative;
    width: 96px;
    height: 96px;
    background: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-banner);
  }

  .banner__ring {
    position: absolute;
    inset: -10px;
    border: 2px dashed rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    animation: bannerSpin 14s linear infinite;
  }

  @keyframes bannerSpin {
    to { transform: rotate(1turn); }
  }

  /* --- Contacto --- */
  .banner__phone {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.1rem + 1.5vw, 2.2rem);
    font-weight: 800;
    color: #fff;
    text-decoration: none;
    margin-bottom: 0.4rem;
    transition: color 0.3s ease;
  }

  .banner__phone:hover {
    color: var(--color-secondary);
  }

  .banner__email {
    font-size: clamp(0.85rem, 0.8rem + 0.2vw, 1rem);
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .banner__email:hover {
    color: #fff;
    text-decoration: underline;
  }

  /* --- Animaciones de entrada --- */
  .aw .w {
    display: inline-block;
    opacity: 0;
    transform: translateY(30px);
  }

  .fade,
  .slide-right {
    opacity: 0;
  }

  .slide-right {
    transform: translateX(40px);
  }

  .banner__container.is-visible .aw .w {
    animation: appear 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    animation-delay: calc(var(--t-title) + var(--w) * 0.04s);
  }

  .banner__container.is-visible .fade,
  .banner__container.is-visible .slide-right {
    animation: appear 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  .banner__container.is-visible .fade {
    animation-delay: var(--t-icon);
  }

  .banner__container.is-visible .slide-right {
    animation-delay: var(--t-contact);
  }

  @keyframes appear {
    to { opacity: 1; transform: translate(0, 0); }
  }

  /* --- Accesibilidad --- */
  @media (prefers-reduced-motion: reduce) {
    .banner__ring {
      animation: none;
    }

    .aw .w,
    .fade,
    .slide-right {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>