---
/**
 * WhyUs.astro — Nosotros: por qué elegirnos
 * ============================================
 * - Blob huevo orgánico (réplica de referencia) + zoom hover, sin play
 * - Número grande Roboto 800 con count-up + título al lado (3 líneas)
 * - AnimatedBar bajo el eyebrow
 * - Párrafos compactos (line-height 1.6) + checks 2×2
 * - padding-top generoso: recibe la tarjeta sobrepuesta de ClientsStats
 */
import { siteConfig } from '../../config/site';
import AnimatedBar from '../ui/AnimatedBar.astro';
import { CheckCircle2 } from 'lucide-astro';

const { eyebrow, number, title, paragraphs, checks, image, imageAlt } = siteConfig.nosotrosWhyUs;

const words = (s: string) => s.split(' ').filter(Boolean);
const lines = (s: string) => s.split(/(?<=[.!?…])\s+/).filter(Boolean);

const titleW = words(title);

// Líneas con índice global (stagger continuo entre párrafos)
let lineIdx = 0;
const paras = paragraphs.map((p) =>
  lines(p).map((t) => ({ t, i: lineIdx++ }))
);
const totalLines = lineIdx;

const WORD = 0.04;
const LINE = 0.15;

const tEyebrow = 0.1;
const tBar = 0.35;
const tHead = 0.55;
const tBlob = 0.5;
const tText = tHead + titleW.length * WORD + 0.4;
const tChecks = tText + totalLines * LINE + 0.3;
---

<section class="why-us" aria-label="Por qué elegirnos">
  <div
    class="why-us__container"
    data-animate
    style={`--t-eyebrow: ${tEyebrow}s; --t-bar: ${tBar}s; --t-head: ${tHead}s; --t-blob: ${tBlob}s; --t-text: ${tText}s; --t-checks: ${tChecks}s;`}
  >
    <!-- Columna 1: blob con imagen (sin play) -->
    <div class="why-us__visual">
      <figure class="why-us__blob slide-left">
        <img src={image} alt={imageAlt} loading="lazy" />
      </figure>
    </div>

    <!-- Columna 2: contenido -->
    <div class="why-us__content">
      <p class="why-us__eyebrow anim-up">{eyebrow}</p>

      <div class="why-us__bar">
        <AnimatedBar start={tBar} />
      </div>

      <div class="why-us__head">
        <span class="why-us__number rise" data-count-to={String(number)}>0</span>
        <h2 class="why-us__title aw">
          {titleW.map((w, i) => <span class="w" style={`--w: ${i}`}>{w}&nbsp;</span>)}
        </h2>
      </div>

      {paras.map((ls) => (
        <p class="why-us__text al">
          {ls.map((l) => <span class="l" style={`--l: ${l.i}`}>{l.t}</span>)}
        </p>
      ))}

      <ul class="why-us__checks">
        {checks.map((c, i) => (
          <li class="why-us__check fade" style={`--i: ${i}`}>
            <CheckCircle2 size={20} />
            <span>{c}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* ============================================
     WHY-US.CSS — Clon de referencia (escala + anchos)
     ============================================ */

  .why-us {
    /* Recibe la mitad de la tarjeta sobrepuesta de ClientsStats */
    padding: 9rem 0 4rem;
    background-color: var(--color-bg);
  }

  .why-us__container {
    width: var(--container-width);
    max-width: var(--container-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 961px) {
    .why-us__container {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 4rem;
    }
  }

  /* --- Mapeo de delays --- */
  .why-us__eyebrow { --start: var(--t-eyebrow); }
  .why-us__bar { --start: var(--t-bar); }
  .why-us__number { --start: var(--t-head); }
  .why-us__title { --start: var(--t-head); }
  .why-us__blob { --start: var(--t-blob); }
  .why-us__text { --start: var(--t-text); }
  .why-us__check { --start: calc(var(--t-checks) + var(--i) * 0.12s); }

  /* --- Estados iniciales --- */
  .anim-up,
  .fade,
  .rise { opacity: 0; }

  .anim-up { transform: translateY(25px); }
  .rise { transform: translateY(30px); }
  .fade { transform: translateY(15px); }

  .slide-left {
    opacity: 0;
    transform: translateX(-60px);
  }

  .aw .w {
    display: inline-block;
    opacity: 0;
    transform: translateX(-40px);
  }

  .al .l {
    display: block;
    opacity: 0;
    transform: translateY(20px);
  }

  /* --- Disparadores --- */
  .why-us__container.is-visible .anim-up,
  .why-us__container.is-visible .fade,
  .why-us__container.is-visible .rise,
  .why-us__container.is-visible .slide-left {
    animation: appear 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    animation-delay: var(--start);
  }

  .why-us__container.is-visible .aw .w {
    animation: appear 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    animation-delay: calc(var(--start) + var(--w) * 0.04s);
  }

  .why-us__container.is-visible .al .l {
    animation: appear 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    animation-delay: calc(var(--start) + var(--l) * 0.15s);
  }

  @keyframes appear {
    to { opacity: 1; transform: translate(0, 0); }
  }

  /* --- Blob huevo inclinado (réplica de referencia) --- */
    .why-us__blob {
    width: min(100%, 450px);
    aspect-ratio: 1 / 1.05;
    overflow: hidden;
    margin: 0 auto;
    border-radius: 50% 50% 48% 52% / 62% 58% 42% 38%;
    rotate: 14deg; /* huevo inclinado: punta arriba-derecha, base abajo-izq */
    box-shadow: 0 20px 50px rgba(10, 25, 47, 0.15);
  }

  .why-us__blob img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .why-us__blob:hover img {
    transform: scale(1.06);
  }

  /* --- Eyebrow + barra --- */
  .why-us__eyebrow {
    font-family: var(--font-heading);
    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.9rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-secondary);
  }

  .why-us__bar {
    margin: 1rem 0 1.75rem;
  }

  /* --- Columna derecha con tope de ancho (solo esta sección) --- */
  .why-us__content {
    max-width: 620px;
  }

  /* --- Número protagonista + título 3 líneas --- */
  .why-us__head {
    display: flex;
    align-items: flex-start;
    gap: 1.85rem;
    margin-bottom: 1.5rem;
  }

  .why-us__number {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 3.5rem + 5vw, 9.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.15em;
    color: var(--color-primary);
  }

  .why-us__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.8vw, 2.65rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.04em;
    max-width: 20ch; /* fuerza ~3 líneas como la referencia */
    color: var(--color-primary);
  }

  .why-us__text {
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.1rem);
    line-height: 1.3;
    max-width: 65ch;
    color: var(--color-text);
    opacity: 0.85;
    margin-bottom: 2rem;
  }

  /* --- Checks 2×2 --- */
  .why-us__checks {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
    margin-top: 2.5rem;
    padding: 0;
  }

  @media (min-width: 640px) {
    .why-us__checks {
      grid-template-columns: 1fr 1fr;
    }
  }

  .why-us__check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: clamp(0.8rem, 0.75rem + 0.2vw, 0.9rem);
    font-weight: 600;
    color: var(--color-primary);
  }

  .why-us__check svg {
    color: var(--color-secondary);
    flex-shrink: 0;
  }

  /* --- Accesibilidad --- */
  @media (prefers-reduced-motion: reduce) {
    .anim-up, .fade, .rise, .slide-left, .aw .w, .al .l {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }

    .why-us__blob:hover img {
      transform: none;
    }
  }
</style>